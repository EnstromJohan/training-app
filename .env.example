# Lokal Supabase: kör `npx supabase start` och kopiera "API URL" och "anon key" hit (.env.local).
# Lämnas tomt kör appen helt lokalt i webbläsaren (IndexedDB) utan synk.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI-uppskattning av kroppsfett från foton (valfritt). Endast på servern – får INTE börja med NEXT_PUBLIC_.
# Kräver även inloggning via Supabase ovan. Skapa nyckel på https://console.anthropic.com
ANTHROPIC_API_KEY=
